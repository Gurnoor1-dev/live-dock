# Neon Postgres (server-side only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Infinite Flight PublicApi v3 OAuth2 (Confidential client; keep all values server-side)
IF_OAUTH_CLIENT_ID=
IF_OAUTH_CLIENT_SECRET=
IF_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/if/callback

# Generate each encryption key independently with: openssl rand -base64 32
IF_SESSION_SECRET=
ADMIN_CREDENTIALS_SECRET=

# Discord application (server-side only)
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Legacy Vercel Cron bearer authentication (retained during transition)
CRON_SECRET=

# Neon Function Trigger bearer authentication (server-side only)
NEON_CRON_SECRET=

# Optional canonical app origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

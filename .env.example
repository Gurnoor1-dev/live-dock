# Supabase — use the project's publishable key, never a service_role key in NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL=https://npsftsvbcqkwsjtlgckj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key. Only needed for trusted server-side jobs.

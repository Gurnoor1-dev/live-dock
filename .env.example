# Infinite Flight PublicApi v3 OAuth2 (Confidential client; keep all values server-side)
IF_OAUTH_CLIENT_ID=
IF_OAUTH_CLIENT_SECRET=
IF_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/if/callback
# Generate with: openssl rand -base64 32
IF_SESSION_SECRET=

# Optional canonical app origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

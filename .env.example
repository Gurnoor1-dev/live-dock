# Virtual Blue / Infinite Flight integration.
# Populate only with the exact values issued for your Infinite Flight OAuth application.
IF_OAUTH_AUTHORIZE_URL=
IF_OAUTH_TOKEN_URL=
IF_OAUTH_CLIENT_ID=
IF_OAUTH_CLIENT_SECRET=
IF_OAUTH_REDIRECT_URI=http://localhost:3000/api/infinite-flight/callback
IF_OAUTH_SCOPES=

# SimBrief integration is optional; pilots can enter their SimBrief username in profile settings.
SIMBRIEF_API_BASE=https://www.simbrief.com/api
